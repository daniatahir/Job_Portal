@model IEnumerable<DbLayer.PostJobTable>

@{
    ViewBag.Title = "All Company Pending Jobs";
}

<h2> All Company Pending Jobs </h2>

<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.JobTitle)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.JobDescription)
        </th>
        <th>
            Min-Max Salary
        </th>

        <th>
            @Html.DisplayNameFor(model => model.Location)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Vacancy)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.WebURL)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CompanyTable.CompanyName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.JobCategoryTable.JobCategory)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.JobNatureTable.JobNature)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.JobStatusTable.JobStatus)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.JobTitle)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.JobDescription)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MinSalary)-@Html.DisplayFor(modelItem => item.MaxSalary)

            </td>

            <td>
                @Html.DisplayFor(modelItem => item.Location)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Vacancy)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WebURL)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CompanyTable.CompanyName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.JobCategoryTable.JobCategory)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.JobNatureTable.JobNature)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.JobStatusTable.JobStatus)
            </td>

            <td>
                @Html.ActionLink("View", "JobDetails", new { id = item.PostJobID }, new { @class = "genric-btn danger circle" })
                @Html.ActionLink("Approve", "ApprovedPost", new { id = item.PostJobID }, new { @class = "genric-btn danger circle" })
                @Html.ActionLink("Cancel", "CanceledPost", new { id = item.PostJobID }, new { @class = "genric-btn danger circle" })

                @Html.ActionLink("DeleteJobPost", "DeleteJobPost", new { id = item.PostJobID }, new { @class = "genric-btn danger circle" })

            </td>
        </tr>
    }

</table>
