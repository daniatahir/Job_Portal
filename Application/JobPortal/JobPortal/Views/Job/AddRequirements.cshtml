@model JobPortal.Models.JobRequirementsMv

@{
    ViewBag.Title = "Job Requirements";
}

<h2>Job Requirements</h2>


<section class="contact-section">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h2 class="contact-title">Add Job Requirements</h2>
            </div>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()


                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="col-md-12">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                @Html.DropDownList("JobRequirementID", null,
                               "Select Requirements",
                               htmlAttributes: new
                               {
                                   @class = "form-control"
                               })
                                @Html.ValidationMessageFor(model => model.JobRequirementID, "", new { @class = "text-danger" })
                                @Html.HiddenFor(model => model.PostJobID);
                            </div>
                        </div>
                        <div>
                            <br/>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                Enter Job Requirement Detail
                                @Html.EditorFor(model => model.JobRequirementDetail, new
                           {
                               htmlAttributes = new
                               {
                                   @class = "form-control valid",
                                   @type = "text",
                                   @name = "jobdescription",
                                   @id = "jobdescription",
                                   @placeholder = "'Enter Job Requirement Detail'",
                                   @onfocus = "this.placeholder=''",
                                   @onblur = "this.placeholder='Enter Job Requirement Detail'",

                               }
                           })
                                @Html.ValidationMessageFor(model => model.JobRequirementDetail, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="form-group mt-3">
                        <input type="submit" value="Add" class="button boxed-btn" />
                    </div>
                </div>

            }
        </div>
    </div>
</section>

<table class="table table-hover">
    <tr>
        <th>
            Job Title
        </th>
        <th>
            Requirements Title
        </th>
        <th>
            Detail
        </th>

        <th>
            Action
        </th>
    </tr>

    @foreach (var item in Model.Details)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.PostJobID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.JobRequirementsTable.JobRequirementTitle)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.JobRequirementDetail)
            </td>


            <td>
                @Html.ActionLink("Delete", "DeleteRequirements", new { id = item.JobRequirementDetailID }, new { @class = "genric-btn danger circle" })
            </td>
        </tr>
    }

</table>
